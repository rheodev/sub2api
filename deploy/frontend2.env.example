# Copy to .env and replace every CHANGE_ME value before starting.
SUB2API_IMAGE=ghcr.io/rheodev/sub2api:frontend2-20261022.1
BIND_HOST=127.0.0.1
SERVER_PORT=8080
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Generate each key separately: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
TOTP_ENCRYPTION_KEY=CHANGE_ME_TOTP_ENCRYPTION_KEY

# Conservative starting values for a 2GB server.
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=5
